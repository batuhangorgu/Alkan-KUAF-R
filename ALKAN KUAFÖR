<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Alkan Erkek Kuaförü</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=Cormorant+Garamond:wght@300;400;600&family=Cinzel:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root {
    --gold: #c9a84c;
    --gold-light: #e8c97a;
    --gold-dark: #8a6f2e;
    --black: #0a0a0a;
    --dark: #111111;
    --dark2: #1a1a1a;
    --cream: #f5ede0;
    --red: #8b1c1c;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--black);
    color: var(--cream);
    font-family: 'Cormorant Garamond', serif;
    overflow-x: hidden;
  }

  /* ── NOISE TEXTURE OVERLAY ── */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 9999;
    opacity: 0.4;
  }

  /* ── NAVBAR ── */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.2rem 4rem;
    background: linear-gradient(to bottom, rgba(0,0,0,0.95), transparent);
    border-bottom: 1px solid rgba(201,168,76,0.15);
  }

  .nav-logo {
    font-family: 'Playfair Display', serif;
    font-size: 1.4rem;
    font-style: italic;
    color: var(--gold);
    letter-spacing: 0.05em;
  }

  .nav-links {
    display: flex;
    gap: 2.5rem;
    list-style: none;
  }

  .nav-links a {
    font-family: 'Cinzel', serif;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: var(--cream);
    text-decoration: none;
    opacity: 0.8;
    transition: color 0.3s, opacity 0.3s;
  }

  .nav-links a:hover { color: var(--gold); opacity: 1; }

  .nav-cta {
    font-family: 'Cinzel', serif;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    color: var(--black);
    background: var(--gold);
    padding: 0.6rem 1.4rem;
    text-decoration: none;
    transition: background 0.3s;
  }

  .nav-cta:hover { background: var(--gold-light); }

  /* ── HERO ── */
  #hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    position: relative;
    overflow: hidden;
  }

  .hero-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 8rem 4rem 4rem 6rem;
    position: relative;
    z-index: 2;
  }

  .hero-eyebrow {
    font-family: 'Cinzel', serif;
    font-size: 0.65rem;
    letter-spacing: 0.4em;
    color: var(--gold);
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: fadeUp 0.8s 0.2s forwards;
  }

  .hero-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(3.5rem, 5vw, 5.5rem);
    font-weight: 900;
    line-height: 1.0;
    margin-bottom: 0.3rem;
    opacity: 0;
    animation: fadeUp 0.8s 0.4s forwards;
  }

  .hero-title .italic {
    font-style: italic;
    color: var(--gold);
    display: block;
  }

  .hero-subtitle {
    font-family: 'Cinzel', serif;
    font-size: 0.8rem;
    letter-spacing: 0.35em;
    color: var(--gold-dark);
    margin-top: 0.8rem;
    margin-bottom: 2.5rem;
    opacity: 0;
    animation: fadeUp 0.8s 0.55s forwards;
  }

  .divider {
    width: 80px;
    height: 1px;
    background: linear-gradient(to right, var(--gold), transparent);
    margin-bottom: 2rem;
    opacity: 0;
    animation: fadeUp 0.8s 0.6s forwards;
  }

  .hero-desc {
    font-size: 1.15rem;
    font-weight: 300;
    line-height: 1.8;
    color: rgba(245,237,224,0.7);
    max-width: 380px;
    margin-bottom: 3rem;
    opacity: 0;
    animation: fadeUp 0.8s 0.7s forwards;
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
    opacity: 0;
    animation: fadeUp 0.8s 0.85s forwards;
  }

  .btn-primary {
    font-family: 'Cinzel', serif;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    color: var(--black);
    background: var(--gold);
    padding: 1rem 2.2rem;
    text-decoration: none;
    transition: all 0.3s;
    position: relative;
    overflow: hidden;
  }

  .btn-primary::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--gold-light);
    transform: translateX(-100%);
    transition: transform 0.3s;
  }

  .btn-primary:hover::after { transform: translateX(0); }
  .btn-primary span { position: relative; z-index: 1; }

  .btn-secondary {
    font-family: 'Cinzel', serif;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    color: var(--gold);
    border: 1px solid var(--gold);
    padding: 1rem 2.2rem;
    text-decoration: none;
    transition: all 0.3s;
  }

  .btn-secondary:hover {
    background: rgba(201,168,76,0.1);
  }

  /* OPEN BADGE */
  .open-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(139,28,28,0.2);
    border: 1px solid var(--red);
    padding: 0.5rem 1rem;
    margin-bottom: 2rem;
    font-family: 'Cinzel', serif;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    color: #e05050;
    opacity: 0;
    animation: fadeUp 0.8s 0.35s forwards;
  }

  .open-badge .dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #e05050;
    animation: pulse 1.5s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.8); }
  }

  /* HERO RIGHT */
  .hero-right {
    position: relative;
    overflow: hidden;
  }

  .hero-right::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, var(--black) 0%, transparent 40%);
    z-index: 1;
  }

  .hero-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.4) sepia(0.3);
  }

  /* BARBER POLE SVG */
  .pole-wrap {
    position: absolute;
    bottom: 5%;
    left: 15%;
    z-index: 2;
    opacity: 0;
    animation: fadeUp 1s 1s forwards;
  }

  .barber-pole {
    width: 60px;
    height: 220px;
    border-radius: 30px;
    background: #1a1a1a;
    border: 2px solid var(--gold-dark);
    overflow: hidden;
    position: relative;
    box-shadow: 0 0 30px rgba(201,168,76,0.2);
  }

  .pole-stripe {
    position: absolute;
    width: 200%;
    height: 30px;
    left: -50%;
    animation: spin 3s linear infinite;
  }

  @keyframes spin {
    from { transform: translateY(0) rotate(0deg); }
    to { transform: translateY(220px) rotate(0deg); }
  }

  /* ── DECO CORNERS ── */
  .corner {
    position: absolute;
    width: 40px; height: 40px;
    border-color: var(--gold-dark);
    border-style: solid;
    opacity: 0.5;
  }
  .corner-tl { top: 130px; left: 40px; border-width: 1px 0 0 1px; }
  .corner-tr { top: 130px; right: 40px; border-width: 1px 1px 0 0; }
  .corner-bl { bottom: 40px; left: 40px; border-width: 0 0 1px 1px; }
  .corner-br { bottom: 40px; right: 40px; border-width: 0 1px 1px 0; }

  /* ── ANNOUNCEMENT BANNER ── */
  .announcement {
    background: linear-gradient(135deg, #1a0e00, #2a1800, #1a0e00);
    border-top: 1px solid var(--gold-dark);
    border-bottom: 1px solid var(--gold-dark);
    padding: 2.5rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .announcement::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgba(201,168,76,0.08) 0%, transparent 70%);
  }

  .ann-tag {
    font-family: 'Cinzel', serif;
    font-size: 0.6rem;
    letter-spacing: 0.4em;
    color: var(--gold);
    display: block;
    margin-bottom: 0.8rem;
  }

  .ann-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    font-weight: 900;
    color: var(--gold-light);
    text-shadow: 0 0 40px rgba(201,168,76,0.4);
  }

  .ann-sub {
    font-size: 1rem;
    color: rgba(245,237,224,0.6);
    margin-top: 0.5rem;
    font-style: italic;
  }

  /* ── SERVICES ── */
  #hizmetler {
    padding: 8rem 6rem;
    position: relative;
  }

  .section-header {
    text-align: center;
    margin-bottom: 5rem;
  }

  .section-tag {
    font-family: 'Cinzel', serif;
    font-size: 0.6rem;
    letter-spacing: 0.5em;
    color: var(--gold);
    display: block;
    margin-bottom: 1rem;
  }

  .section-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 3vw, 3rem);
    font-weight: 700;
  }

  .section-title em {
    font-style: italic;
    color: var(--gold);
  }

  .section-line {
    width: 60px;
    height: 1px;
    background: var(--gold);
    margin: 1.5rem auto 0;
    opacity: 0.5;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: rgba(201,168,76,0.1);
    border: 1px solid rgba(201,168,76,0.1);
  }

  .service-card {
    background: var(--dark);
    padding: 3rem 2rem;
    text-align: center;
    transition: background 0.4s;
    position: relative;
    overflow: hidden;
  }

  .service-card::before {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 2px;
    background: var(--gold);
    transform: scaleX(0);
    transition: transform 0.4s;
  }

  .service-card:hover { background: #161616; }
  .service-card:hover::before { transform: scaleX(1); }

  .service-icon {
    font-size: 2.5rem;
    margin-bottom: 1.5rem;
    display: block;
    filter: sepia(1) hue-rotate(10deg) saturate(2) brightness(1.2);
  }

  .service-name {
    font-family: 'Cinzel', serif;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: var(--gold);
    margin-bottom: 0.8rem;
  }

  .service-desc {
    font-size: 0.95rem;
    color: rgba(245,237,224,0.5);
    line-height: 1.7;
    font-weight: 300;
  }

  /* ── ABOUT ── */
  #hakkimizda {
    padding: 8rem 6rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8rem;
    align-items: center;
    background: var(--dark2);
    border-top: 1px solid rgba(201,168,76,0.1);
    border-bottom: 1px solid rgba(201,168,76,0.1);
  }

  .about-number {
    font-family: 'Playfair Display', serif;
    font-size: clamp(5rem, 8vw, 8rem);
    font-weight: 900;
    color: transparent;
    -webkit-text-stroke: 1px rgba(201,168,76,0.3);
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .about-label {
    font-family: 'Cinzel', serif;
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    color: var(--gold-dark);
  }

  .stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin-top: 3rem;
  }

  .about-text {
    font-size: 1.1rem;
    line-height: 1.9;
    color: rgba(245,237,224,0.65);
    font-weight: 300;
  }

  .slogan {
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    font-style: italic;
    color: var(--gold-light);
    margin: 2rem 0;
    padding-left: 1.5rem;
    border-left: 2px solid var(--gold);
  }

  /* ── CONTACT ── */
  #iletisim {
    padding: 8rem 6rem;
    text-align: center;
    position: relative;
  }

  #iletisim::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center bottom, rgba(201,168,76,0.05) 0%, transparent 60%);
  }

  .contact-phone {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 700;
    color: var(--gold);
    letter-spacing: 0.1em;
    margin: 2rem 0;
    display: block;
    text-decoration: none;
    transition: color 0.3s;
  }

  .contact-phone:hover { color: var(--gold-light); }

  .contact-note {
    font-family: 'Cinzel', serif;
    font-size: 0.65rem;
    letter-spacing: 0.35em;
    color: rgba(245,237,224,0.4);
    margin-top: 1rem;
  }

  .contact-box {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    border: 1px solid rgba(201,168,76,0.2);
    padding: 4rem 6rem;
    margin-top: 3rem;
    position: relative;
  }

  .contact-box::before,
  .contact-box::after {
    content: '◆';
    position: absolute;
    color: var(--gold);
    font-size: 0.6rem;
    top: -0.4rem;
  }
  .contact-box::before { left: 2rem; }
  .contact-box::after { right: 2rem; }

  /* ── FOOTER ── */
  footer {
    background: #050505;
    border-top: 1px solid rgba(201,168,76,0.15);
    padding: 2rem 4rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-logo {
    font-family: 'Playfair Display', serif;
    font-size: 1.2rem;
    font-style: italic;
    color: var(--gold);
  }

  .footer-copy {
    font-family: 'Cinzel', serif;
    font-size: 0.55rem;
    letter-spacing: 0.2em;
    color: rgba(245,237,224,0.3);
  }

  /* ── ANIMATIONS ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ── SCROLLED REVEAL ── */
  .reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }
  .reveal.visible { opacity: 1; transform: translateY(0); }

  /* ── GOLD ORNAMENT ── */
  .ornament {
    display: flex;
    align-items: center;
    gap: 1rem;
    justify-content: center;
    margin: 1.5rem 0;
  }
  .ornament-line { flex: 1; max-width: 80px; height: 1px; background: linear-gradient(to right, transparent, var(--gold-dark)); }
  .ornament-line.r { background: linear-gradient(to left, transparent, var(--gold-dark)); }
  .ornament-diamond { color: var(--gold); font-size: 0.6rem; }

  /* ── GALERİ ── */
  #galeri {
    padding: 8rem 6rem;
    background: var(--dark2);
    border-top: 1px solid rgba(201,168,76,0.1);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
    margin-top: 3rem;
  }

  .gallery-item {
    aspect-ratio: 3/4;
    overflow: hidden;
    position: relative;
    background: #1a1a1a;
    border: 1px solid rgba(201,168,76,0.1);
    cursor: pointer;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease, filter 0.4s;
    filter: brightness(0.85) sepia(0.1);
  }

  .gallery-item:hover img {
    transform: scale(1.06);
    filter: brightness(1) sepia(0);
  }

  .gallery-item .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, transparent 50%);
    opacity: 0;
    transition: opacity 0.3s;
    display: flex;
    align-items: flex-end;
    padding: 1rem;
  }

  .gallery-item:hover .overlay { opacity: 1; }

  .gallery-item .overlay span {
    font-family: 'Cinzel', serif;
    font-size: 0.55rem;
    letter-spacing: 0.2em;
    color: var(--gold);
  }

  /* Upload zone */
  .upload-zone {
    border: 2px dashed rgba(201,168,76,0.3);
    padding: 3rem;
    text-align: center;
    margin-top: 2rem;
    transition: border-color 0.3s, background 0.3s;
    cursor: pointer;
    position: relative;
  }

  .upload-zone:hover, .upload-zone.drag-over {
    border-color: var(--gold);
    background: rgba(201,168,76,0.04);
  }

  .upload-zone input[type=file] {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
    width: 100%;
    height: 100%;
  }

  .upload-icon { font-size: 2rem; margin-bottom: 1rem; display: block; }

  .upload-title {
    font-family: 'Cinzel', serif;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: var(--gold);
    margin-bottom: 0.5rem;
  }

  .upload-sub {
    font-size: 0.85rem;
    color: rgba(245,237,224,0.4);
  }

  .upload-count {
    font-family: 'Cinzel', serif;
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    color: var(--gold-dark);
    margin-top: 2rem;
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.95);
    z-index: 9998;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .lightbox.open { display: flex; }

  .lightbox img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    border: 1px solid rgba(201,168,76,0.2);
  }

  .lightbox-close {
    position: absolute;
    top: 1.5rem; right: 2rem;
    font-family: 'Cinzel', serif;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: var(--gold);
    cursor: pointer;
    background: none;
    border: 1px solid rgba(201,168,76,0.3);
    padding: 0.5rem 1rem;
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(201,168,76,0.15);
    border: 1px solid rgba(201,168,76,0.3);
    color: var(--gold);
    font-size: 1.2rem;
    padding: 1rem 1.2rem;
    cursor: pointer;
    transition: background 0.3s;
  }

  .lightbox-nav:hover { background: rgba(201,168,76,0.3); }
  .lightbox-prev { left: 1rem; }
  .lightbox-next { right: 1rem; }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    nav { padding: 1rem 1.5rem; }
    .nav-links { display: none; }
    #hero { grid-template-columns: 1fr; }
    .hero-left { padding: 7rem 1.5rem 3rem; }
    .hero-right { display: none; }
    #hizmetler { padding: 5rem 1.5rem; }
    .services-grid { grid-template-columns: 1fr 1fr; }
    #hakkimizda { grid-template-columns: 1fr; gap: 3rem; padding: 5rem 1.5rem; }
    #iletisim { padding: 5rem 1.5rem; }
    .contact-box { padding: 3rem 2rem; }
    footer { flex-direction: column; gap: 1rem; text-align: center; }
  }
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <div class="nav-logo">Alkan <span style="font-size:0.85rem;font-style:normal;letter-spacing:0.08em;">Erkek Kuaförü</span></div>
  <ul class="nav-links">
    <li><a href="#hizmetler">Hizmetler</a></li>
    <li><a href="#hakkimizda">Hakkımızda</a></li>
    <li><a href="#galeri">Galeri</a></li>
    <li><a href="#iletisim">İletişim</a></li>
  </ul>
  <a href="tel:05411481308" class="nav-cta">Randevu Al</a>
</nav>

<!-- HERO -->
<section id="hero">
  <div class="corner corner-tl"></div>
  <div class="corner corner-tr"></div>
  <div class="corner corner-bl"></div>
  <div class="corner corner-br"></div>

  <div class="hero-left">
    <div class="open-badge">
      <span class="dot"></span>
      BAYRAMDA DA AÇIK — PAZAR DAHİL
    </div>
    <p class="hero-eyebrow">ERKEK KUAFÖRÜ</p>
    <h1 class="hero-title">
      <span class="italic">Alkan</span>
      Erkek<br>Kuaförü
    </h1>
    <p class="hero-subtitle">ERKEK BAKIMININ SANATI</p>
    <div class="divider"></div>
    <p class="hero-desc">
      Klasik berberlik geleneğini modern zarafetle buluşturan Alkan Erkek Kuaförü'nde, her ziyaret bir deneyime dönüşür.
    </p>
    <div class="hero-buttons">
      <a href="tel:05411481308" class="btn-primary"><span>HEMEN ARA</span></a>
      <a href="#hizmetler" class="btn-secondary">HİZMETLERİMİZ</a>
    </div>
  </div>

  <div class="hero-right">
    <!-- Dark barbershop atmosphere via CSS -->
    <div style="width:100%;height:100%;background:
